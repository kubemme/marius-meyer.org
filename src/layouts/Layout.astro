---
interface Props {
  title?: string;
  description?: string;
  activePage?: string;
}

const {
  title = 'Marius Meyer — Fotografie',
  description = 'Fotografien von Landschaft, Natur und unterwegs.',
  activePage,
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111310" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="Marius Meyer – Startseite">
        <span class="wordmark-mark" aria-hidden="true">
          <img src={`${base}favicon.svg`} alt="" />
        </span>
        <span class="wordmark-name">Marius Meyer<span class="wordmark-dot">.</span></span>
      </a>
      <nav aria-label="Hauptnavigation">
        <a class:list={{ active: activePage === 'index' }} href={`${base}`}>Home</a>
        <a class:list={{ active: activePage === 'collections' }} href={`${base}collections/`}>Portfolio</a>
        <a class:list={{ active: activePage === 'about' }} href={`${base}about/`}>Über mich</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <nav class="social-strip" aria-label="Social Media">
        <span class="eyebrow">Social Media</span>
        <a href="https://www.instagram.com/_mariusmeyer_" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href="https://www.komoot.com/de-de/user/507278383378" target="_blank" rel="noopener noreferrer">Komoot</a>
        <a href="https://www.polarsteps.com/tetraodontiform" target="_blank" rel="noopener noreferrer">Polarsteps</a>
      </nav>
      <div class="footer-main">
        <a class="wordmark footer-wordmark" href={base}>
          <span class="copyright">© {new Date().getFullYear()} Marius Meyer</span>
        </a>
        <div class="footer-links">
          <a href={`${base}datenschutzerklaerung/`}>Datenschutz</a>
          <a href={`${base}impressum/`}>Impressum</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    font-family: 'DM Sans', sans-serif;
    color: #efeee8;
    background: #111310;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    --paper: #191c18;
    --ink: #efeee8;
    --muted: #a4a69e;
    --accent: #d47754;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; min-width: 320px; }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; }
  button { font: inherit; }
  .site-header {
    height: 86px; padding: 0 7.2%; display: flex; align-items: center;
    justify-content: space-between; border-bottom: 1px solid rgba(255, 255, 255, .12);
  }
  .wordmark { display: inline-flex; align-items: center; gap: 11px; }
  .wordmark-mark {
    display: grid; place-items: center; width: 35px; height: 35px;
  }
  .wordmark-mark img { width: 100%; height: 100%; }
  .wordmark-name { font-size: 14px; font-weight: 600; letter-spacing: -.04em; }
  .wordmark-dot { color: var(--accent); }
  nav { display: flex; align-items: center; gap: 38px; font-size: 12px; }
  nav a { transition: color .2s ease; }
  nav a:hover, nav a.active { color: var(--accent); }
  .site-footer { color: var(--muted); }
  .social-strip {
    display: flex; justify-content: center; align-items: center; gap: 25px; padding: 28px 20px;
    border-top: 1px solid rgba(255, 255, 255, .12); font-size: 12px;
  }
  .social-strip a { display: inline-flex; }
  .social-strip a:hover { color: var(--accent); }
  .footer-main {
    padding: 31px 7.2%; display: flex; align-items: center; justify-content: space-between;
    border-top: 1px solid rgba(255, 255, 255, .12); font-size: 11px;
  }
  .footer-wordmark { color: var(--ink); }
  .footer-links { display: flex; gap: 16px; }
  .footer-links a:hover { color: var(--ink); }
  .copyright { white-space: nowrap; }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 10px; text-transform: uppercase;
    letter-spacing: .16em; font-size: 10px; font-weight: 600;
  }
  .eyebrow::before { content: ''; width: 23px; height: 1px; background: var(--accent); }
  .serif { font-family: 'Playfair Display', Georgia, serif; font-weight: 500; }
  .text-link {
    display: inline-flex; align-items: center; gap: 16px; padding-bottom: 7px;
    border-bottom: 1px solid var(--ink); font-size: 12px; transition: gap .2s ease;
  }
  .text-link:hover { gap: 23px; }

  @media (max-width: 700px) {
    .site-header { height: 72px; padding: 0 6%; }
    nav { gap: 17px; font-size: 11px; }
    .wordmark-name { font-size: 13px; }
    .social-strip { flex-wrap: wrap; gap: 16px; }
    .footer-main { padding: 25px 6%; flex-wrap: wrap; gap: 18px; }
    .copyright { margin-left: auto; }
  }
</style>
