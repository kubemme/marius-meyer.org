---
import Layout from '../layouts/Layout.astro';
import { galleryCategories, photos } from '../data/photos';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const featuredPhotos = galleryCategories.map((category) => ({
  ...photos.find((photo) => photo.categorySlug === category.slug)!,
  title: category.title,
  location: `${category.count} Fotos`,
}));
---

<Layout
  title="Marius Meyer - Portfolio"
>
  <section class="hero">
    <div class="hero-copy">
      <span class="eyebrow">Marius Meyer</span>
      <h1 class="serif">Der Typ<br />mit der<br /><em>Sonnenbrille</em></h1>
      <p class="hero-description">
        Das bin ich, Marius – Hobbyfotograf aus der Nähe von Köln.
      </p>
      <a class="text-link" href={`${base}about/`}>Über mich</a>
    </div>
    <div class="hero-image-wrap">
      <img
        class="hero-image"
        src={`${base}images/about.jpg`}
        alt="Marius Meyer mit Sonnenbrille und Outdoorjacke"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="intro" id="arbeiten">
    <div class="section-label">Mein Portfolio</div>
    <div class="intro-main">
      <div>
        <h2 class="serif">Erlebnisse,<br /><em>festgehalten.</em></h2>
        <p>
          Landschaft, Tiere, Stadt, Nacht und abstrakte Motive.
        </p>
      </div>
    </div>
    <div class="featured-grid">
      {featuredPhotos.map((photo, index) => (
        <a
          class:list={['photo-card', `photo-card-${index + 1}`]}
          href={`${base}collections/?category=${photo.categorySlug}`}
        >
          <div
            class:list={['photo-frame', { 'photo-frame-portrait': photo.aspectRatio < 1 }]}
            style={`--photo-image: url('${base}${photo.image}')`}
          >
            <img src={`${base}${photo.image}`} alt="" loading="lazy" />
          </div>
          <div class="photo-meta">
            <div><h3>{photo.title}</h3><span>{photo.location}</span></div>
            <span class="photo-category">{photo.category}</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative; min-height: min(720px, calc(100vh - 86px)); padding: 8.5vh 7.2%;
    display: grid; grid-template-columns: .88fr 1.12fr; align-items: center; gap: 5%;
  }
  .hero-copy { position: relative; z-index: 1; padding: 16px 0 42px; }
  h1 { margin: 27px 0 21px; font-size: clamp(58px, 7.7vw, 106px); line-height: .96; letter-spacing: -.065em; }
  h1 em, h2 em { color: var(--accent); font-weight: 500; }
  .hero-description { max-width: 360px; margin: 0 0 28px; color: var(--muted); font-size: 13px; line-height: 1.8; }
  .hero-image-wrap { position: relative; height: min(590px, 73vh); min-height: 400px; }
  .hero-image { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .image-caption { position: absolute; right: 18px; bottom: 17px; color: white; font-size: 9px; letter-spacing: .13em; text-shadow: 0 1px 5px #000; }
  .scroll-hint { position: absolute; bottom: 35px; left: 7.2%; display: flex; align-items: center; gap: 12px; color: var(--muted); font-size: 10px; }
  .scroll-hint span { width: 30px; height: 1px; background: var(--accent); }
  .intro { padding: 0 10% 128px; }
  .section-label { display: flex; gap: 14px; color: var(--muted); text-transform: uppercase; letter-spacing: .13em; font-size: 10px; }
  .section-label span { color: var(--accent); }
  .intro-main { display: flex; align-items: end; justify-content: space-between; margin: 34px 0 46px; }
  .intro-main h2 { margin: 0; font-size: clamp(42px, 5vw, 66px); line-height: 1.04; letter-spacing: -.05em; }
  .intro-main p { max-width: 370px; margin: 18px 0 0; color: var(--muted); font-size: 12px; line-height: 1.8; }
  .intro-main > .text-link { margin: 0 0 8px; }
  .featured-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: start; }
  .photo-card-2 { margin-top: 62px; }
  .photo-card-3 { margin-top: 20px; }
  .photo-card-4 { margin-top: 55px; }
  .photo-card-5 { margin-top: 12px; }
  .photo-frame { position: relative; overflow: hidden; background: #252823; aspect-ratio: 3 / 2; }
  .photo-frame img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .photo-frame-portrait { display: grid; place-items: center; isolation: isolate; }
  .photo-frame-portrait::before {
    position: absolute; z-index: 0; inset: -12px; content: '';
    background: var(--photo-image) center / cover no-repeat;
    filter: blur(12px); transform: scale(1.05); opacity: .7;
  }
  .photo-frame-portrait img {
    position: relative; z-index: 1; width: auto; max-width: 100%; height: 100%; object-fit: contain;
  }
  .photo-card:hover .photo-frame img { transform: scale(1.035); }
  .photo-meta { display: flex; justify-content: space-between; gap: 10px; padding-top: 15px; }
  .photo-meta h3 { margin: 0 0 5px; font-family: 'Playfair Display', Georgia, serif; font-size: 17px; font-weight: 500; }
  .photo-meta span { color: var(--muted); font-size: 10px; }
  .photo-meta .photo-category { padding-top: 4px; }
  .closing { padding: 125px 20px 135px; text-align: center; }
  .social-links { display: flex; justify-content: center; gap: 26px; }

  @media (max-width: 900px) {
    .hero { padding-left: 6%; padding-right: 6%; gap: 3%; }
    .hero-image-wrap { min-height: 350px; }
    .intro { padding-left: 7%; padding-right: 7%; }
  }
  @media (max-width: 650px) {
    .hero { min-height: unset; padding: 52px 6% 75px; grid-template-columns: 1fr; gap: 32px; }
    .hero-copy { padding: 0; }
    h1 { margin: 21px 0 17px; font-size: clamp(61px, 17vw, 88px); }
    .hero-description { max-width: 390px; }
    .hero-image-wrap { height: 70vw; min-height: 290px; }
    .scroll-hint { display: none; }
    .intro { padding: 80px 6% 88px; }
    .intro-main { margin: 27px 0 32px; display: block; }
    .intro-main h2 { font-size: 53px; }
    .intro-main > .text-link { margin-top: 25px; }
    .featured-grid { grid-template-columns: 1fr 1fr; gap: 27px 13px; }
    .photo-card-2, .photo-card-3, .photo-card-4, .photo-card-5 { margin-top: 0; }
    .photo-meta { padding-top: 10px; }
    .photo-meta h3 { font-size: 15px; }
    .photo-meta .photo-category { display: none; }
    .closing { padding: 90px 16px 100px; }
    .social-links { flex-wrap: wrap; gap: 18px; }
  }
</style>
