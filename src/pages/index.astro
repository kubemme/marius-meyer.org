---
import Layout from '../layouts/Layout.astro';
import { photos } from '../data/photos';

const featuredPhotos = photos.filter((photo) => photo.featured);
---

<Layout>
  <section class="hero">
    <div class="hero-copy">
      <span class="eyebrow">Fotografie &amp; Geschichten</span>
      <h1 class="serif">Die Welt<br />in <em>Zwischen-</em><br />momenten.</h1>
      <p class="hero-description">
        Ich bin Marius – Fotograf und neugieriger Beobachter. Immer auf der Suche nach
        dem besonderen Licht und den leisen Geschichten dazwischen.
      </p>
      <a class="text-link" href="/collections">Arbeiten entdecken <span aria-hidden="true">↗</span></a>
      <span class="hero-index">01 <span>/</span> 03</span>
    </div>
    <div class="hero-image-wrap">
      <img
        class="hero-image"
        src="https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=1800&q=90"
        alt="Bergsee im ersten Licht des Tages"
        fetchpriority="high"
      />
      <span class="image-caption">46° 28' N &nbsp; 11° 46' E — DOLOMITEN</span>
      <span class="hero-image-number">01</span>
    </div>
    <a class="scroll-hint" href="#arbeiten"><span></span> Scrollen</a>
  </section>

  <section class="intro" id="arbeiten">
    <div class="section-label"><span>01</span> Ausgewählte Arbeiten</div>
    <div class="intro-main">
      <div>
        <h2 class="serif">Momente, die<br /><em>bleiben.</em></h2>
        <p>Ein paar Lieblingsbilder aus unterwegs sein, ankommen und genau hinsehen.</p>
      </div>
      <a class="text-link" href="/collections">Alle Arbeiten <span aria-hidden="true">↗</span></a>
    </div>
    <div class="featured-grid">
      {featuredPhotos.map((photo, index) => (
        <a class:list={['photo-card', `photo-card-${index + 1}`]} href="/collections">
          <div class="photo-frame">
            <img src={photo.image} alt={photo.alt} loading="lazy" />
            <span class="photo-arrow" aria-hidden="true">↗</span>
          </div>
          <div class="photo-meta">
            <div><h3>{photo.title}</h3><span>{photo.location}</span></div>
            <span class="photo-category">{photo.category}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="statement">
    <div class="statement-image">
      <img
        src="https://images.unsplash.com/photo-1472396961693-142e6e269027?auto=format&fit=crop&w=1500&q=85"
        alt="Hirsche stehen im stillen Morgennebel"
        loading="lazy"
      />
    </div>
    <div class="statement-copy">
      <span class="eyebrow">Meine Perspektive</span>
      <h2 class="serif">Nicht nur sehen.<br /><em>Wirklich fühlen.</em></h2>
      <p>
        Für mich beginnt ein gutes Bild mit Zeit. Zeit, einen Ort kennenzulernen,
        Licht zu beobachten und den Moment einfach passieren zu lassen.
      </p>
      <a class="text-link" href="/about">Mehr über mich <span aria-hidden="true">↗</span></a>
      <span class="statement-note">MARIUS MEYER — FOTOGRAF AUS LEIDENSCHAFT</span>
    </div>
  </section>

  <section class="closing">
    <span class="eyebrow">Lass uns etwas festhalten</span>
    <h2 class="serif">Eine gute Geschichte<br />beginnt mit <em>Hallo.</em></h2>
    <a class="text-link" href="mailto:hallo@marius-meyer.org">Projekt anfragen <span aria-hidden="true">↗</span></a>
  </section>
</Layout>

<style>
  .hero {
    position: relative; min-height: min(720px, calc(100vh - 86px)); padding: 8.5vh 7.2%;
    display: grid; grid-template-columns: .88fr 1.12fr; align-items: center; gap: 5%;
  }
  .hero-copy { position: relative; z-index: 1; padding: 16px 0 42px; }
  h1 { margin: 27px 0 21px; font-size: clamp(58px, 7.7vw, 106px); line-height: .96; letter-spacing: -.065em; }
  h1 em, h2 em { color: var(--accent); font-weight: 500; }
  .hero-description { max-width: 340px; margin: 0 0 28px; color: var(--muted); font-size: 13px; line-height: 1.8; }
  .hero-index { display: block; margin-top: 84px; font-size: 10px; letter-spacing: .1em; }
  .hero-index span { padding: 0 7px; color: #a9aaa3; }
  .hero-image-wrap { position: relative; height: min(590px, 73vh); min-height: 400px; }
  .hero-image { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .image-caption { position: absolute; right: 18px; bottom: 17px; color: white; font-size: 9px; letter-spacing: .13em; text-shadow: 0 1px 5px #000; }
  .hero-image-number { position: absolute; top: -19px; right: -17px; color: var(--accent); font-family: 'Playfair Display', Georgia, serif; font-size: 48px; }
  .scroll-hint { position: absolute; bottom: 35px; left: 7.2%; display: flex; align-items: center; gap: 12px; color: var(--muted); font-size: 10px; }
  .scroll-hint span { width: 30px; height: 1px; background: var(--accent); }
  .intro { padding: 120px 10% 128px; }
  .section-label { display: flex; gap: 14px; color: var(--muted); text-transform: uppercase; letter-spacing: .13em; font-size: 10px; }
  .section-label span { color: var(--accent); }
  .intro-main { display: flex; align-items: end; justify-content: space-between; margin: 34px 0 46px; }
  .intro-main h2, .statement h2, .closing h2 { margin: 0; font-size: clamp(42px, 5vw, 66px); line-height: 1.04; letter-spacing: -.05em; }
  .intro-main p { max-width: 340px; margin: 18px 0 0; color: var(--muted); font-size: 12px; line-height: 1.8; }
  .intro-main > .text-link { margin: 0 0 8px; }
  .featured-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; align-items: start; }
  .photo-card-2 { margin-top: 62px; }
  .photo-card-3 { margin-top: 20px; }
  .photo-frame { position: relative; overflow: hidden; background: #dedbd2; aspect-ratio: 4 / 5; }
  .photo-card-2 .photo-frame { aspect-ratio: 4 / 5.4; }
  .photo-card-3 .photo-frame { aspect-ratio: 4 / 4.7; }
  .photo-frame img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .photo-card:hover .photo-frame img { transform: scale(1.035); }
  .photo-arrow { position: absolute; right: 13px; bottom: 13px; display: grid; place-items: center; width: 35px; height: 35px; background: var(--paper); border-radius: 50%; opacity: 0; transform: translateY(5px); transition: .25s ease; }
  .photo-card:hover .photo-arrow { opacity: 1; transform: translateY(0); }
  .photo-meta { display: flex; justify-content: space-between; gap: 10px; padding-top: 15px; }
  .photo-meta h3 { margin: 0 0 5px; font-family: 'Playfair Display', Georgia, serif; font-size: 17px; font-weight: 500; }
  .photo-meta span { color: var(--muted); font-size: 10px; }
  .photo-meta .photo-category { padding-top: 4px; }
  .statement { min-height: 640px; display: grid; grid-template-columns: 1fr 1fr; background: #e9e7df; }
  .statement-image { min-height: 640px; }
  .statement-image img { width: 100%; height: 100%; object-fit: cover; }
  .statement-copy { position: relative; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; padding: 90px 12%; }
  .statement-copy h2 { margin-top: 31px; font-size: clamp(40px, 4.4vw, 58px); }
  .statement-copy p { max-width: 380px; margin: 22px 0 28px; color: var(--muted); font-size: 12px; line-height: 1.9; }
  .statement-note { position: absolute; right: 12%; bottom: 28px; color: #92938c; font-size: 8px; letter-spacing: .15em; }
  .closing { padding: 125px 20px 135px; text-align: center; }
  .closing h2 { margin: 25px 0 27px; font-size: clamp(42px, 5.2vw, 68px); }

  @media (max-width: 900px) {
    .hero { padding-left: 6%; padding-right: 6%; gap: 3%; }
    .hero-image-wrap { min-height: 350px; }
    .hero-index { margin-top: 55px; }
    .intro { padding-left: 7%; padding-right: 7%; }
    .statement-copy { padding: 70px 9%; }
  }
  @media (max-width: 650px) {
    .hero { min-height: unset; padding: 52px 6% 75px; grid-template-columns: 1fr; gap: 32px; }
    .hero-copy { padding: 0; }
    h1 { margin: 21px 0 17px; font-size: clamp(61px, 17vw, 88px); }
    .hero-description { max-width: 390px; }
    .hero-index { display: none; }
    .hero-image-wrap { height: 70vw; min-height: 290px; }
    .hero-image-number { right: -8px; font-size: 39px; }
    .scroll-hint { display: none; }
    .intro { padding: 80px 6% 88px; }
    .intro-main { margin: 27px 0 32px; display: block; }
    .intro-main h2 { font-size: 53px; }
    .intro-main > .text-link { margin-top: 25px; }
    .featured-grid { grid-template-columns: 1fr 1fr; gap: 27px 13px; }
    .photo-card-2, .photo-card-3 { margin-top: 0; }
    .photo-card:nth-child(3) { display: none; }
    .photo-frame, .photo-card-2 .photo-frame, .photo-card-3 .photo-frame { aspect-ratio: 4 / 5; }
    .photo-meta { padding-top: 10px; }
    .photo-meta h3 { font-size: 15px; }
    .photo-meta .photo-category { display: none; }
    .statement { grid-template-columns: 1fr; }
    .statement-image { min-height: 0; height: 78vw; }
    .statement-copy { min-height: 410px; padding: 70px 8%; }
    .statement-copy h2 { font-size: 48px; }
    .statement-note { right: 8%; }
    .closing { padding: 90px 16px 100px; }
  }
</style>
