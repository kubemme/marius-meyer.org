---
import Layout from '../layouts/Layout.astro';
import { galleryCategories, photos } from '../data/photos';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout
  title="Portfolio - Marius Meyer"
  activePage="collections"
>
  <section class="collection-page">
    <div class="collection-heading">
      <span class="eyebrow">Portfolio</span>
      <h1 class="serif">Bilder aus <em>meiner Welt.</em></h1>
    </div>
    <div class="filters" aria-label="Fotogalerien filtern">
      {galleryCategories.map((category) => (
        <button
          class={`filter${category.slug === 'landschaft' ? ' active' : ''}`}
          type="button"
          data-filter={category.slug}
          aria-pressed={category.slug === 'landschaft' ? 'true' : 'false'}
        >
          {category.title} <span>{String(category.count).padStart(2, '0')}</span>
        </button>
      ))}
    </div>
    <div class="gallery">
      {photos.map((photo, index) => (
        <article
          class="gallery-item"
          data-category={photo.categorySlug}
          hidden={photo.categorySlug !== 'landschaft'}
        >
          <a
            class:list={['gallery-image', { 'gallery-image-portrait': photo.aspectRatio < 1 }]}
            href={`${base}${photo.original}`}
            style={`--photo-image: url('${base}${photo.image}'); --portrait-width: ${(photo.aspectRatio / 1.5) * 100}%`}
            aria-label={`Foto ${String(index + 1).padStart(2, '0')} aus ${photo.category} in Originalgröße öffnen`}
          >
            <img src={`${base}${photo.image}`} alt="" loading={index < 6 ? 'eager' : 'lazy'} />
          </a>
        </article>
      ))}
    </div>
  </section>
  <dialog class="lightbox" aria-label="Foto in Originalgröße">
    <div class="lightbox-content">
      <button class="lightbox-close" type="button" aria-label="Fotoansicht schließen">×</button>
      <button class="lightbox-previous" type="button" aria-label="Vorheriges Foto">‹</button>
      <img class="lightbox-image" alt="" />
      <button class="lightbox-next" type="button" aria-label="Nächstes Foto">›</button>
      <span class="lightbox-count" aria-live="polite"></span>
    </div>
  </dialog>
</Layout>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.filter');
  const items = document.querySelectorAll<HTMLElement>('.gallery-item');
  const lightbox = document.querySelector<HTMLDialogElement>('.lightbox');
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>('.lightbox-image');
  const lightboxCount = lightbox?.querySelector<HTMLElement>('.lightbox-count');
  let visiblePhotos: HTMLAnchorElement[] = [];
  let currentPhoto = 0;

  const showPhoto = (index: number) => {
    if (!lightbox || !lightboxImage || visiblePhotos.length === 0) return;
    currentPhoto = (index + visiblePhotos.length) % visiblePhotos.length;
    const link = visiblePhotos[currentPhoto];
    lightboxImage.src = link.href;
    lightboxImage.alt = link.querySelector('img')?.alt ?? '';
    if (lightboxCount) lightboxCount.textContent = `${currentPhoto + 1} / ${visiblePhotos.length}`;
    if (!lightbox.open) lightbox.showModal();
  };

  document.querySelectorAll<HTMLAnchorElement>('.gallery-image').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      visiblePhotos = [...document.querySelectorAll<HTMLAnchorElement>('.gallery-item:not([hidden]) .gallery-image')];
      showPhoto(visiblePhotos.indexOf(link));
    });
  });

  lightbox?.querySelector('.lightbox-close')?.addEventListener('click', () => lightbox.close());
  lightbox?.querySelector('.lightbox-previous')?.addEventListener('click', () => showPhoto(currentPhoto - 1));
  lightbox?.querySelector('.lightbox-next')?.addEventListener('click', () => showPhoto(currentPhoto + 1));
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) lightbox.close();
  });
  lightbox?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      event.preventDefault();
      lightbox.close();
    } else if (event.key === 'ArrowLeft') {
      event.preventDefault();
      showPhoto(currentPhoto - 1);
    } else if (event.key === 'ArrowRight') {
      event.preventDefault();
      showPhoto(currentPhoto + 1);
    }
  });

  const applyFilter = (category: string) => {
    filters.forEach((button) => {
      const selected = button.dataset.filter === category;
      button.classList.toggle('active', selected);
      button.setAttribute('aria-pressed', String(selected));
    });
    items.forEach((item) => {
      item.hidden = item.dataset.category !== category;
    });
  };

  filters.forEach((filter) => {
    filter.addEventListener('click', () => applyFilter(filter.dataset.filter ?? 'landschaft'));
  });

  const requestedCategory = new URLSearchParams(window.location.search).get('category');
  const requestedFilter = [...filters].find((filter) => filter.dataset.filter === requestedCategory);
  applyFilter(requestedFilter?.dataset.filter ?? 'landschaft');
</script>

<style>
  .collection-page { padding: 93px 10% 125px; }
  .collection-heading { text-align: center; }
  .collection-heading .eyebrow { justify-content: center; }
  h1 { margin: 20px 0 12px; font-size: clamp(55px, 7vw, 88px); line-height: 1; letter-spacing: -.06em; }
  h1 em { color: var(--accent); font-weight: 500; }
  .collection-heading p { max-width: 410px; margin: 0 auto; color: var(--muted); font-size: 12px; line-height: 1.8; }
  .filters { display: flex; justify-content: center; flex-wrap: wrap; gap: 20px 30px; margin: 54px 0 38px; }
  .filter { border: 0; padding: 0 0 8px; background: transparent; color: var(--muted); font-size: 11px; cursor: pointer; }
  .filter.active { border-bottom: 1px solid var(--accent); color: var(--ink); }
  .filter span { padding-left: 5px; color: var(--accent); font-size: 9px; }
  .gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px 20px; }
  .gallery-item[hidden] { display: none; }
  .gallery-item { min-width: 0; }
  .gallery-image { position: relative; display: block; aspect-ratio: 3 / 2; overflow: hidden; background: #252823; }
  .gallery-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .gallery-image-portrait { display: grid; place-items: center; isolation: isolate; }
  .gallery-image-portrait::before {
    position: absolute; z-index: 0; inset: -12px; content: '';
    background: var(--photo-image) center / cover no-repeat;
    filter: blur(12px); transform: scale(1.05); opacity: .7;
  }
  .gallery-image-portrait img {
    position: relative; z-index: 1; width: var(--portrait-width); max-width: 100%; height: 100%; object-fit: contain;
  }
  .gallery-item:hover img { transform: scale(1.03); }
  .lightbox {
    max-width: 100vw;
    max-height: 100vh;
    padding: 0;
    overflow: visible;
    border: 0;
    background: transparent;
  }
  .lightbox::backdrop { background: rgb(8 10 8 / 94%); }
  .lightbox-content { position: relative; display: grid; place-items: center; }
  .lightbox-image { display: block; width: auto; height: auto; max-width: 94vw; max-height: 88vh; object-fit: contain; }
  .lightbox-close, .lightbox-previous, .lightbox-next {
    position: absolute;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgb(255 255 255 / 35%);
    border-radius: 50%;
    background: rgb(17 19 16 / 72%);
    color: #fff;
    font: inherit;
    font-size: 27px;
    line-height: 1;
    cursor: pointer;
  }
  .lightbox-close { top: 12px; right: 12px; }
  .lightbox-previous { top: 50%; left: 12px; transform: translateY(-50%); }
  .lightbox-next { top: 50%; right: 12px; transform: translateY(-50%); }
  .lightbox-count { position: absolute; right: 12px; bottom: 12px; color: #fff; font-size: 11px; text-shadow: 0 1px 5px #000; }
  @media (max-width: 750px) {
    .collection-page { padding: 70px 6% 90px; }
    .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 13px; }
    .filters { gap: 15px 23px; margin: 39px 0 27px; }
  }
  @media (max-width: 390px) {
    .filters { gap: 12px 16px; }
  }
</style>
